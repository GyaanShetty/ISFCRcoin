# 32-byte hex seeds. Generate with: openssl rand -hex 32
FAUCET_SEED=
INSTRUCTOR_SEED=
# ADMIN_TOKEN: 12+ chars; the node refuses to start in production without it
ADMIN_TOKEN=
CHAIN_NAME=isfcr
# 1 = any name works as a join code (dev); 0 = instructor-issued codes only
OPEN_JOIN=0
# Expected hashes per block at start; retargeting adjusts from here.
INITIAL_WORK=262144
TXGEN=1
# Secondary node only (docker compose -f docker-compose.peer.yml up):
# PRIMARY_URL=https://isfcr.example.org
# OLD_RULES=1   # hard-fork demo: ignore governance switches
TUNNEL_TOKEN=
# Per-IP request limits per minute (0 = off). Raise/zero RATE_JOIN_PER_MIN for load tests or one shared campus NAT.
RATE_JOIN_PER_MIN=120
RATE_WRITE_PER_MIN=1200
# Comma-separated browser origins allowed to call the API (empty = any).
CORS_ORIGINS=
# 1 only if port 8080 is NOT reachable from the LAN (tunnel-only), so X-Forwarded-For can be trusted.
TRUST_PROXY=0
